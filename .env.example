# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# From platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash handles tool calls, JSON and images, so it is used for everything.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash

# Matches docker-compose.yml (host port 5433)
DATABASE_URL=postgres://lexhack:lexhack@localhost:5433/lexhack

# Web app port. Set TELEGRAM_ENABLED=false to run only the web app
# (only one process may poll a bot token at a time).
WEB_PORT=3100
TELEGRAM_ENABLED=true
